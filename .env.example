# Base de datos (la crea setup.sh con estos mismos valores por defecto)
DATABASE_URL=postgresql://pathar_user:pathar_password@localhost:5432/pathar_db

# JWT — usá cualquier texto largo y random, no hace falta que sea este
JWT_SECRET_KEY=cambiar-esto-por-cualquier-texto-secreto-largo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Firebase Admin (verificación de Google Sign-In) — pedile este archivo
# a un compañero del equipo, no se genera solo
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
